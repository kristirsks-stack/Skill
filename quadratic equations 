
#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, c, d;
    cout << "Enter a, b and c: ";
    cin >> a >> b >> c;

    d = b * b - 4 * a * c;

    if (d > 0) {
        cout << "Root 1 = " << (-b + sqrt(d)) / (2 * a) << endl;
        cout << "Root 2 = " << (-b - sqrt(d)) / (2 * a);
    }
    else if (d == 0) {
        cout << "Equal roots = " << -b / (2 * a);
    }
    else {
        cout << "Roots are imaginary";
    }

    return 0;
}
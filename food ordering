#include <iostream>
using namespace std;

int main()
{
    int choice, quantity;
    float price, total;

    cout << "===== FOOD ORDERING SYSTEM =====" << endl;
    cout << "1. Pizza  - Rs. 200" << endl;
    cout << "2. Burger - Rs. 100" << endl;
    cout << "3. Pasta  - Rs. 150" << endl;
    cout << "4. Sandwich - Rs. 80" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    cout << "Enter quantity: ";
    cin >> quantity;

    if (choice == 1)
        price = 200;
    else if (choice == 2)
        price = 100;
    else if (choice == 3)
        price = 150;
    else if (choice == 4)
        price = 80;
    else
        price = 0;

    total = price * quantity;

    cout << "Total Cost = Rs. " << total << endl;

    return 0;
}
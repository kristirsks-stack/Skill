#include <iostream>
using namespace std;

int main()
{
    string username, password;

    cout << "Enter username: ";
    cin >> username;

    if (username == "admin")
    {
        cout << "Enter password: ";
        cin >> password;

        if (password == "12345")
        {
            cout << "Login successful";
        }
        else
        {
            cout << "Wrong password";
        }
    }
    else
    {
        cout << "Wrong username";
    }

    return 0;
}